# ============================================================
# 示例变量文件（terraform.tfvars.example）
# 用途：说明 infra/ 可调参数。复制为 terraform.tfvars 后按需修改。
# ⚠️ 凭据安全（C8）：AK/SK、DMS 密码等敏感值一律通过环境变量
#    或本文件注入，但本示例仅用占位符，禁止写入真实凭据。
#    真实凭据注入方式：
#      export TF_VAR_access_key="<AK>"
#      export TF_VAR_secret_key="<SK>"
#      export TF_VAR_dms_password="<DMS_PASSWORD>"
# ============================================================

# 华为云区域（OBS / DMS 需在同一区域）
region = "cn-north-4"

# 对象存储桶名称（全局唯一）
bucket_name = "obstrans-demo-bucket"

# 桶存储类别：STANDARD / WARM / COLD
storage_class = "STANDARD"

# 桶 ACL：private / public-read / public-read-write / authenticated-read / bucket-owner-full-control
bucket_acl = "private"

# ---- 分布式集群模式（DMS Kafka，可选）----
# 仅在需要多节点并行传输编排时置为 true
create_dms = false
dms_name   = "obstrans-dms"
# 以下两项在 create_dms = true 时必填（填写你账号下的 VPC / 子网 ID）
dms_vpc_id    = ""
dms_subnet_id = ""
dms_az        = "cn-north-4a"
# dms_password 通过环境变量 TF_VAR_dms_password 注入，勿在此落盘明文
# dms_password  = "<your-password>"
